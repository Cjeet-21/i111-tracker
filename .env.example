# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# DATABASE_URL  -> pooled endpoint, used by the app at runtime.
# DIRECT_URL    -> direct endpoint, used by Prisma Migrate / Prisma Studio.
#
# For Neon, run:  node scripts/wire-neon-env.mjs
# It fills these in from the Neon CLI (pooled URL gets
# ?sslmode=require&pgbouncer=true&connection_limit=1, which Prisma needs
# when talking to the Neon pooler).
#
# For a local PostgreSQL, e.g. the embedded one from `npm run db:local`:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:55432/i111?schema=public"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:55432/i111?schema=public"
DATABASE_URL=""
DIRECT_URL=""

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Canonical URL of the deployed app (used for future email/notification links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
