# PostgreSQL connection string (Neon, Supabase, Railway, Aiven, Docker, ...)
# Local dev with the embedded database: npm run db:local  (prints these values)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/i111?schema=public&sslmode=require"

# Direct (non-pooler) connection used by Prisma Migrate.
# Neon: use the "-ep" direct URL. Locally it is usually identical to DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/i111?schema=public&sslmode=require"

# Secret used to sign session cookies. Generate with:
#   openssl rand -base64 32        (Linux/macOS)
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"   (Windows/Node)
AUTH_SECRET=""

# Canonical URL of the deployed app (used for future email/notification links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
